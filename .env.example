# FoodFlow environment variables - TEMPLATE.
# Copy to ".env" (git-ignored) and replace every "change-me" value.
#
#   cp .env.example .env
#
# Who reads what:
#   - docker compose        reads POSTGRES_* to create the database container
#   - Spring Boot backend   reads DB_*, JWT_*, SERVER_PORT, CORS_ALLOWED_ORIGINS
#     (via spring.config.import in application.yml, or real env vars in Docker)

# ---------- PostgreSQL container ----------
POSTGRES_DB=foodflow
POSTGRES_USER=foodflow
POSTGRES_PASSWORD=change-me
# Host port for PostgreSQL. Change to 5433 if you already run PostgreSQL locally.
POSTGRES_PORT=5432

# ---------- Backend -> database ----------
# Must point at the same database/user/password as above.
DB_URL=jdbc:postgresql://localhost:5432/foodflow
DB_USERNAME=foodflow
DB_PASSWORD=change-me

# ---------- Backend ----------
SERVER_PORT=8080
# Used from Phase 3 to sign JWTs. At least 32 random bytes, Base64-encoded.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=change-me
# Token lifetime in milliseconds (86400000 = 24 hours).
JWT_EXPIRATION_MS=86400000
# Browser origins allowed to call the API directly (comma-separated).
# 5173 = Vite dev server, 3000 = Docker frontend. (Both proxy /api, so this is only a fallback.)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Docker ports / options ----------
FRONTEND_PORT=3000
BACKEND_PORT=8080
# Business time zone for "today" and daily charts.
APP_TIMEZONE=Asia/Kolkata
# Fill an empty database with demo accounts, restaurants and orders (development only).
SEED_DEMO_DATA=true
# Fraction of simulated payments that fail at random (0.0 - 1.0), for demos.
PAYMENT_FAILURE_RATE=0.0
# Set to false in production to hide the API map.
SWAGGER_ENABLED=true
